# Python
.venv/
__pycache__/
*.pyc

# 打包产物
/dist/
/build/
*.egg-info/

# Windows 桌面版的内置渲染 runtime（scripts/build_worker_runtime.py 生成）：
# 200 MiB 上下的二进制，随安装包分发但**绝不进 Git**。
# 版本锁在 packaging/runtime-lock.json 里，那个才是要提交的东西。
/runtime/

# 前端构建产物（scripts/build_frontend.py 生成，随 wheel 分发但不进仓库）
/src/magplot/web/
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/

# 运行时数据：装成包后一律落在用户数据目录
# （macOS ~/Library/Application Support/Magplot、Linux ~/.local/share/magplot、
#  Windows %LOCALAPPDATA%\Magplot）。下面几个是旧版本在仓库里留下的残余。
/cache/
/exports/
/layouts/
/baked_overrides.json
*.log
.pytest_cache/

# Tauri 桌面壳（src-tauri/ 源码进仓库；构建产物与 CLI 生成的 schema 不进）
src-tauri/target/
src-tauri/gen/

# Rust supervisor magplot-workerd（workerd/ 源码进仓库；构建产物不进）
workerd/target/

# 工具与系统
.gstack/
.DS_Store

# 开发期界面验证截图：含真实研究图，不进公开仓
/docs/verify/

# 内部执行清单 / 路线图，不进公开仓
/docs/MAGPLOT_RENAME_AND_MATURITY_PLAN.md
.impeccable/

# CodeGraph 本地索引（可再生）
.codegraph/
