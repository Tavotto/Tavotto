      ],
      "unverified": [
        "「更紧凑」是主观目标：Phase 0 只核不变量，目标本身留给 L3 几何度量 / L5 视觉评价"
      ],
      "split": "holdout"
    },
    {
      "id": "FB-V03",
      "title": "误差棒变细，误差不能变",
      "category": "scientific",
      "task_type": "figure_edit",
      "fixture": "errorbar_fit",
      "instruction": "误差棒线宽改成 0.6。",
      "check": "probe",
