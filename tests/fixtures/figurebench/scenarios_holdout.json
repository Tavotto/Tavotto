{
  "schema": 1,
  "benchmark": "tavotto-figurebench",
  "split_rule": "sha256(id) % 5 == 0 -> holdout",
  "split": "holdout",
  "scenarios": [
    {
      "id": "FB-S01",
      "title": "改一条曲线的颜色",
      "category": "single_element",
      "task_type": "figure_edit",
      "fixture": "line_two_series",
      "instruction": "把 treated 那条曲线改成绿色 #2ca02c，其他保持不变。",
      "check": "probe",
      "needs_real_model": false,
      "expected_outcome": "completed",
      "subjective": false,
      "goal": [
        {
          "id": "g.color",
          "kind": "line_property",
          "axes": 0,
          "series": "treated",
          "prop": "color",
          "expected": "#2ca02c"
        }
      ],
      "preserve": [
        {
          "id": "p.data.control",
          "kind": "series_data_unchanged",
          "axes": 0,
          "series": "control"
        },
        {
          "id": "p.data.treated",
          "kind": "series_data_unchanged",
          "axes": 0,
          "series": "treated"
        },
        {
          "id": "p.color.control",
          "kind": "line_property_unchanged",
          "axes": 0,
          "series": "control",
          "prop": "color"
        }
      ],
      "reference_solution": [
        {
          "file": "figure.py",
          "find": "color=\"#d62728\"",
          "replace": "color=\"#2ca02c\"",
          "count": 1
        }
      ],
      "negative_variants": [
        {
          "id": "n.data_changed",
          "edits": [
            {
              "file": "figure.py",
              "find": "color=\"#d62728\"",
              "replace": "color=\"#2ca02c\"",
              "count": 1
            },
            {
              "file": "figure.py",
              "find": "4.1, 4.8",
              "replace": "4.0, 4.8",
              "count": 1
            }
          ],
          "must_fail": [
            "p.data.treated"
          ]
        },
        {
          "id": "n.wrong_series",
          "edits": [
            {
              "file": "figure.py",
              "find": "color=\"#1f77b4\"",
              "replace": "color=\"#2ca02c\"",
              "count": 1
            }
          ],
          "must_fail": [
            "g.color",
            "p.color.control"
          ]
        }
      ],
      "unverified": [],
      "split": "holdout"
    },
    {
      "id": "FB-C03",
      "title": "加宽整张图",
      "category": "complex_figure",
      "task_type": "figure_edit",
