      "preserve": [
        {
          "id": "p.points",
          "kind": "errorbar_points_unchanged",
          "axes": 0,
          "index": 0
        },
        {
          "id": "p.err",
          "kind": "errorbar_data_unchanged",
          "axes": 0,
          "index": 0
        },
        {
          "id": "p.fit",
          "kind": "series_data_unchanged",
          "axes": 0,
          "series": "fit"
        },
        {
          "id": "p.slope",
          "kind": "text_unchanged",
          "axes": 0,
          "which": "title"
