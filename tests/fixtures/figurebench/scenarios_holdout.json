      ],
      "reference_solution": [
        {
          "file": "figure.py",
          "find": "elinewidth=1.2",
          "replace": "elinewidth=0.6",
          "count": 1
        }
      ],
      "negative_variants": [
        {
          "id": "n.err_halved",
          "edits": [
            {
              "file": "figure.py",
              "find": "elinewidth=1.2",
              "replace": "elinewidth=0.6",
              "count": 1
            },
            {
              "file": "figure.py",
              "find": "YERR = [0.3, 0.3,",
              "replace": "YERR = [0.15, 0.15,",
              "count": 1
            }
          ],
          "must_fail": [
            "p.err"
          ]
        },
        {
          "id": "n.outlier_dropped_from_fit",
          "edits": [
            {
              "file": "figure.py",
              "find": "fit_x, fit_y = X, Y",
              "replace": "fit_x, fit_y = X[:-1], Y[:-1]",
              "count": 1
            }
          ],
          "must_fail": [
            "p.fit",
            "p.slope"
          ]
        }
      ],
      "unverified": [],
      "split": "holdout"
    },
    {
