          "axes": 0,
          "series": "A: control"
        },
        {
          "id": "p.data.1",
          "kind": "series_data_unchanged",
          "axes": 1,
          "series": "B: treated"
        },
        {
          "id": "p.data.2",
          "kind": "series_data_unchanged",
          "axes": 2,
          "series": "C: dose"
        },
        {
          "id": "p.data.3",
          "kind": "series_data_unchanged",
          "axes": 3,
          "series": "D: recovery"
        },
        {
          "id": "p.height",
          "kind": "fig_size_unchanged",
          "dim": "height"
        },
        {
