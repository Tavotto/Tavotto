    {
      "id": "FB-C04",
      "title": "排版更紧凑但不拆共享轴",
      "category": "complex_figure",
      "task_type": "figure_edit",
      "fixture": "multi_panel",
      "instruction": "让四个子图排得更紧凑一些。",
      "check": "probe",
      "needs_real_model": false,
      "expected_outcome": "completed",
      "subjective": true,
      "goal": [],
      "preserve": [
        {
          "id": "p.data.0",
          "kind": "series_data_unchanged",
          "axes": 0,
          "series": "A: control"
        },
        {
          "id": "p.data.1",
          "kind": "series_data_unchanged",
          "axes": 1,
          "series": "B: treated"
        },
        {
          "id": "p.data.2",
          "kind": "series_data_unchanged",
          "axes": 2,
          "series": "C: dose"
        },
        {
          "id": "p.data.3",
          "kind": "series_data_unchanged",
          "axes": 3,
          "series": "D: recovery"
        },
        {
          "id": "p.shared",
          "kind": "shared_x",
          "axes": [
            0,
            2
          ]
        },
        {
          "id": "p.count",
          "kind": "axes_count_unchanged"
        }
      ],
      "reference_solution": [
        {
          "file": "figure.py",
          "find": "    fig.savefig(",
          "replace": "    fig.tight_layout()\n    fig.savefig(",
          "count": 1
        }
      ],
      "negative_variants": [
        {
          "id": "n.unshared",
          "edits": [
            {
              "file": "figure.py",
              "find": "sharex=True, ",
              "replace": "",
              "count": 1
            }
          ],
          "must_fail": [
            "p.shared"
          ]
