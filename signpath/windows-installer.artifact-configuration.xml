<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="Tavotto-${version}-Windows-Setup.exe"
      product-name="Tavotto"
      product-version="${version}"
      file-version="${version}">
      <authenticode-sign
        description="Tavotto Windows installer"
        description-url="https://github.com/Tavotto/Tavotto" />
    </pe-file>
  </zip-file>
</artifact-configuration>
