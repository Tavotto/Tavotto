{
  "mcpServers": {
    "tavotto": {
      "title": "Tavotto",
      "description": "打开 Tavotto 交互画布：拖图例与图内文字、改字号线宽刻度、跑投稿前检查、导出真矢量 PDF。",
      "command": "./mcp/launch",
      "args": ["./mcp/server.py"],
      "cwd": ".",
      "env_vars": ["TAVOTTO_CLI", "TAVOTTO_MCP_PYTHON", "TAVOTTO_MCP_ROOTS", "TAVOTTO_MCP_WORKSPACE", "CODEX_WORKSPACE_ROOT", "CODEX_PROJECT_ROOT", "CODEX_WORKSPACE_DIR", "TAVOTTO_MCP_WIDGET", "TAVOTTO_MCP_NO_AUTO_PROVISION", "TAVOTTO_WORKER_PYTHON", "TAVOTTO_CONFIG_DIR", "TAVOTTO_DATA_DIR", "TAVOTTO_NO_REVIEW_SHARE", "PATH", "HOME", "USERPROFILE", "LOCALAPPDATA"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 1800
    }
  }
}
