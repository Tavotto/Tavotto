{
  "log": { "level": "warn", "timestamp": true },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "in-trojan",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "set_system_proxy": false
    },
    {
      "type": "mixed",
      "tag": "in-hysteria2",
      "listen": "127.0.0.1",
      "listen_port": 7891,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    {
      "type": "trojan",
      "tag": "trojan",
      "server": "${trojan.server}",
      "server_port": "${trojan.server_port}",
      "password": "${trojan.password}",
      "tls": { "enabled": true, "server_name": "${trojan.server_name}", "alpn": ["h2", "http/1.1"] }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2",
      "server": "${hysteria2.server}",
      "server_port": "${hysteria2.server_port}",
      "up_mbps": 10,
      "down_mbps": 50,
      "password": "${hysteria2.password}",
      "obfs": { "type": "${hysteria2.obfs_type}", "password": "${hysteria2.obfs_password}" },
      "tls": { "enabled": true, "server_name": "${hysteria2.server_name}", "alpn": "${hysteria2.alpn}" }
    },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "rules": [
      { "inbound": ["in-trojan", "in-hysteria2"], "ip_is_private": true, "outbound": "block" },
      { "inbound": ["in-trojan", "in-hysteria2"], "domain": ["localhost"], "domain_suffix": [".localhost", ".local", ".ts.net", ".internal"], "outbound": "block" },
      { "inbound": ["in-trojan"], "outbound": "trojan" },
      { "inbound": ["in-hysteria2"], "outbound": "hysteria2" }
    ],
    "final": "block"
  }
}
