 "figure_script": "\"\"\"合成子图：两条曲线 + 图例（评测用，坐标轴矩形与范围写死）。\"\"\"\nfrom pathlib import Path\n\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nOUT = Path(__file__).resolve().parent\n\n\ndef main():\n    x = np.linspace(0, 10, 12)\n    y1 = 1 - np.exp(-x / 3)\n    y2 = 1 - np.exp(-x / 6)\n    fig = plt.figure(figsize=(80 / 25.4, 60 / 25.4))\n    ax = fig.add_axes([0.15, 0.15, 0.8, 0.75])\n    ax.plot(x, y1, marker=\"o\", ms=3, lw=1.0, label=\"Sample A\")\n    ax.plot(x, y2, ls=\"--\", marker=\"s\", ms=3, lw=1.0, label=\"Sample B\")\n    ax.set_xlim(0, 10)\n    ax.set_ylim(0, 1.1)\n    ax.set_xlabel(\"Time (min)\")\n    ax.set_ylabel(\"Conversion (-)\")\n    ax.legend(loc=\"lower right\", frameon=False)\n    fig.savefig(OUT / \"FigM.pdf\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
