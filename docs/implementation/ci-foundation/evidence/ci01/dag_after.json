{
  "jobs": {
    "python-lint": {
      "name": "Python quality (Ruff)",
      "needs": [],
      "if": "github.event_name == 'pull_request' || github.event_name == 'merge_group'",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 10,
      "matrix": null,
      "yaml_step_count": 6
    },
    "cla-check": {
      "name": "Contributor licence (CLA)",
      "needs": [],
      "if": "github.event_name == 'pull_request' || github.event_name == 'merge_group'",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 10,
      "matrix": null,
      "yaml_step_count": 3
    },
    "invariants": {
      "name": "invariants",
      "needs": [],
      "if": "github.event_name == 'pull_request' || github.event_name == 'merge_group'",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 20,
      "matrix": null,
      "yaml_step_count": 5
    },
    "backend-fast": {
      "name": "backend-fast",
      "needs": [],
      "if": "github.event_name == 'pull_request' || github.event_name == 'merge_group'",
      "runs_on": "${{ matrix.os }}",
      "timeout_minutes": 40,
      "matrix": [
        {
          "os": "ubuntu-latest",
          "python": "3.10"
        },
        {
          "os": "ubuntu-latest",
          "python": "3.13"
        },
        {
          "os": "ubuntu-latest",
          "python": "3.14"
        }
      ],
      "yaml_step_count": 4
    },
    "backend-platforms": {
      "name": "backend-platforms",
      "needs": [],
      "if": "github.event_name == 'merge_group' || (github.event_name == 'pull_request' && contains(github.event.pull_request.labels.*.name, 'full-ci'))",
      "runs_on": "${{ matrix.os }}",
      "timeout_minutes": 60,
      "matrix": [
        {
          "os": "macos-latest",
          "python": "3.13"
        },
        {
          "os": "windows-latest",
          "python": "3.13"
        }
      ],
      "yaml_step_count": 4
    },
    "compat-smoke": {
      "name": "compat-smoke",
      "needs": [],
      "if": "github.event_name == 'pull_request' || github.event_name == 'merge_group'",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 20,
      "matrix": null,
      "yaml_step_count": 5
    },
    "frontend": {
