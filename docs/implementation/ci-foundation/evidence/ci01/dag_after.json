    "ci-fast-gate": {
      "name": "CI fast gate",
      "needs": [
        "python-lint",
        "cla-check",
        "invariants",
        "backend-fast",
        "frontend",
        "plugin-candidate",
        "workerd",
        "desktop-shell",
        "compat-smoke"
