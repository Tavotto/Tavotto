      "runs_on": "ubuntu-latest",
      "timeout_minutes": 10,
      "matrix": null,
      "yaml_step_count": 3
    },
    "ci-integration-gate": {
      "name": "CI integration gate",
      "needs": [
        "backend-platforms",
        "package",
        "windows-exe-smoke",
        "macos-app-smoke",
        "posix-e2e"
      ],
      "if": "always() && (github.event_name == 'pull_request' || github.event_name == 'merge_group')",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 10,
      "matrix": null,
      "yaml_step_count": 3
    },
    "main-landing-audit": {
      "name": "main landing audit",
      "needs": [],
      "if": "github.event_name == 'push'",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 15,
      "matrix": null,
      "yaml_step_count": 6
