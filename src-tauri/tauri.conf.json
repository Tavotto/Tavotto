{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magplot",
  "mainBinaryName": "Magplot",
  "version": "0.7.0",
  "identifier": "com.erwanjun.magplot",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/erwanjun/magplot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NzUwNTc4QzY3QjYyMTEKUldRUlludkdlQVYxbEtlaGEwY1kvNVl2N0ViOFV1bndiNTI5dHdNdzRrRDE5L3NmY0VEWXlQUWMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/128x128.png",
      "icons/icon.png",
      "../assets/icon/icon.icns",
      "../assets/icon/icon.ico"
    ],
    "resources": {
      "../dist/Magplot": "sidecar/Magplot"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "template": "windows/installer.nsi",
        "installerIcon": "../assets/icon/icon.ico",
        "headerImage": "../assets/brand/installer-header.bmp",
        "sidebarImage": "../assets/brand/installer-sidebar.bmp"
      }
    }
  }
}
