{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magplot",
  "mainBinaryName": "Magplot",
  "version": "0.3.0",
  "identifier": "com.erwanjun.magplot",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/128x128.png",
      "icons/icon.png",
      "../assets/icon/icon.icns",
      "../assets/icon/icon.ico"
    ],
    "resources": {
      "../dist/Magplot": "sidecar/Magplot"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
