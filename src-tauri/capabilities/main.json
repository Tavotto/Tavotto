{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "主窗口（内容来自本机 sidecar 的 127.0.0.1 端口）能用的最小权限：监听菜单事件 + 原生目录选择 + 在文件管理器中选中导出文件 / 项目文件夹（只 reveal、不 open）+ 切换原生菜单语言 + 安装/诊断 Codex 集成（只 spawn tavotto-cli codex install|doctor --json）+ 关窗前询问未保存工作 + 应用内更新（经壳自有命令检查/下载/安装，来源 COS 镜像优先或 GitHub，验签用内置公钥；+ 重启）+ 窗框（macOS 顶栏空白处拖动 / 双击缩放窗口；Windows 无系统标题栏：顶栏空白处拖动 / 双击缩放、页面右上角的最小化 / 最大化 / 关闭、顶栏「菜单」按钮弹出应用菜单；关闭照旧走关窗询问闸）。不开放 shell、fs、任意 opener。",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "allow-reveal-export",
    "allow-reveal-project-dir",
    "allow-set-menu-locale",
    "allow-codex-integration",
    "allow-host-integration",
    "allow-arm-close-guard",
    "allow-resolve-close-request",
    "allow-desktop-update-check",
    "allow-desktop-update-install",
    "allow-take-previous-exit",
    "allow-current-engine-exit",
    "allow-current-fullscreen",
    "allow-restart-engine",
    "process:allow-restart",
    "allow-native-file-drop",
    "allow-show-app-menu",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}
