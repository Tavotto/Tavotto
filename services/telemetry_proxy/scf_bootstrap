#!/bin/bash
# 腾讯云 SCF **Web 函数**的启动文件。
#
# Web 函数的契约就两条：起一个进程、监听 0.0.0.0:9000。剩下的和别处一模一样
# ——跑的是同一个 `application`，和本地调试、和 Vercel 跑的是同一份代码。
#
# 两个坑：
#   * 这个文件必须有可执行权限（755/777），否则函数起不来；
#   * `-u` 关掉 stdout 缓冲，不然日志要等缓冲区满了才出现，排障时看起来像没日志。
#
# 运行时只有 /tmp 可写；代理不写任何文件，正合适。
export HOST=0.0.0.0
export PORT=9000
exec python3 -u -m tavotto_telemetry_proxy.wsgi
