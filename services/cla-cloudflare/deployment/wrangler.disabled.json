{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tavotto-cla-REPLACE_BEFORE_REVIEWED_DEPLOYMENT",
  "main": "../src/entry.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "vars": {
    "CLA_GITHUB_ENABLED": "false",
    "CLA_OAUTH_ENABLED": "false",
    "CLA_SIGNING_ENABLED": "false",
    "CLA_CHECK_PUBLISHING_ENABLED": "false",
    "CLA_UI_ENABLED": "false",
    "CLA_BACKGROUND_ENABLED": "false",
    "CLA_CI_VERIFICATION_ENABLED": "false",
    "CLA_DELEGATED_COUNTERSIGNING_ENABLED": "false",
    "CLA_AUTOMATIC_VERIFICATION_ENABLED": "false",
    "CLA_AUTOMATIC_PUBLISHING_ENABLED": "false",
    "CLA_AGREEMENT_ACTIVATION_ENABLED": "false",
    "CLA_CONFIG": "REPLACE_WITH_REVIEWED_CONFIG_JSON"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_EXISTING_REVIEWED_DATABASE_NAME",
      "database_id": "REPLACE_WITH_EXISTING_REVIEWED_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": "./assets-reviewed",
    "binding": "CLA_PUBLIC_AGREEMENT",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "CLA_OAUTH_LIMITER",
      "namespace_id": "REPLACE_WITH_DISTINCT_REVIEWED_NAMESPACE_CLA_OAUTH_LIMITER",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "CLA_VERIFICATION_LIMITER",
      "namespace_id": "REPLACE_WITH_DISTINCT_REVIEWED_NAMESPACE_CLA_VERIFICATION_LIMITER",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CLA_WEBHOOK_LIMITER",
      "namespace_id": "REPLACE_WITH_DISTINCT_REVIEWED_NAMESPACE_CLA_WEBHOOK_LIMITER",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
