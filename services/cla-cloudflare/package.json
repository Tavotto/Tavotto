{
  "name": "tavotto-cla-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:migration": "python3 tests/migration.test.py",
    "typecheck": "tsc --noEmit",
    "build": "node tests/build-production.mjs",
    "check": "npm run typecheck && npm test && npm run test:migration && npm run build && npm run test:mutation",
    "test:mutation": "node tests/mutation-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
