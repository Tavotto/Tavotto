{
  "_doc": "Agent 新增的画布对象的字段表（ADR 0208 §五）：唯一出处。后端 engine/agentobjects.py 与前端 web/src/lib/agentObjects.ts 都读这一份；前端另有逐键覆盖表（每个对象接口的键都要标 accept / withhold / reserved，漏一个 tsc 就红）。只用来校验 Agent 新增的对象，不许挂到文档保存路径（validate_document 只查骨架的理由见 engine/documents.py）。数值上下限取属性栏现有的范围，预算取现有接口的上限（来源写在 budgets._from 里，看护 tests/test_agent_objects.py）。",
  "version": 1,
  "budgets": {
    "_from": "max_objects = app.SVG_COPY_MAX_OBJECTS；max_nodes = app.SVG_COPY_MAX_NODES；max_text_chars = app.SVG_COPY_MAX_TEXT；max_gradient_stops = svgimport.MAX_STOPS；max_dash_items = geometry.valid_dash_pattern（1–12 个）；max_coord_mm = svgimport.MAX_VIEWPORT_MM；max_group_depth = ADR 0208 §七之二 第 4 条（层级不超过 4 层）；max_ratio / max_name_chars / max_local_id_chars 与文字 padding 上限 50 mm 是本表自己的；其余数值上下限取属性栏：线宽 / 边框 0.1–20 pt、不透明度 0–1、斜接上限 1–100（StrokeSection）、圆角 0–50 mm、边数 3–12、星形比例 0.05–0.95（ShapeSection）、字号 3–200 pt 与行距 0.5–5（lib/typography）",
    "max_objects": 2000,
    "max_nodes": 200000,
    "max_text_chars": 20000,
    "max_gradient_stops": 1000,
    "max_dash_items": 12,
    "max_coord_mm": 10000.0,
    "max_group_depth": 4,
    "max_ratio": 10.0,
    "max_name_chars": 120,
    "max_local_id_chars": 64
  },
  "id_prefix": { "text": "t", "arrow": "a", "shape": "s", "path": "p", "group": "g" },
  "common": {
    "id": { "kind": "local_id", "required": true },
    "type": { "kind": "type", "required": true },
    "x": { "kind": "coord", "required": true },
    "y": { "kind": "coord", "required": true },
    "w": { "kind": "size", "required": true },
    "h": { "kind": "size", "required": true },
    "name": { "kind": "name" },
    "groupPath": { "kind": "group_path" },
    "rotationDeg": { "kind": "number", "min": -360, "max": 360 }
  },
  "reserved": ["anchor", "glyph", "groupNames"],
  "types": {
    "text": {
      "text": { "kind": "text", "required": true },
      "sizePt": { "kind": "number", "required": true, "min": 3, "max": 200 },
      "bold": { "kind": "bool", "required": true },
      "color": { "kind": "color", "required": true },
      "align": { "kind": "enum", "required": true, "values": ["left", "center", "right"] },
      "fontFamily": { "kind": "enum", "values": ["serif", "sans-serif", "monospace"] },
      "interpretation": { "kind": "enum", "values": ["auto", "scientific"] },
      "textFormat": { "kind": "enum", "values": ["latex"] },
      "italic": { "kind": "bool" },
      "underline": { "kind": "bool" },
      "lineHeight": { "kind": "number", "min": 0.5, "max": 5 },
      "padding": { "kind": "number", "min": 0, "max": 50 },
      "bg": { "kind": "color_or_null" },
      "borderColor": { "kind": "color_or_null" },
      "borderPt": { "kind": "number", "min": 0.1, "max": 20 }
    },
    "arrow": {
      "start": { "kind": "endpoint", "required": true },
      "end": { "kind": "endpoint", "required": true },
      "strokePt": { "kind": "number", "required": true, "min": 0.1, "max": 20 },
      "color": { "kind": "color", "required": true },
      "head": { "kind": "enum", "required": true, "values": ["none", "end", "both"] },
      "headStart": { "kind": "enum", "values": ["none", "triangle", "open", "bar", "dot", "diamond", "stealth"] },
      "headEnd": { "kind": "enum", "values": ["none", "triangle", "open", "bar", "dot", "diamond", "stealth"] },
      "headSizeStart": { "kind": "enum", "values": ["small", "medium", "large"] },
      "headSizeEnd": { "kind": "enum", "values": ["small", "medium", "large"] },
      "dash": { "kind": "enum", "values": ["solid", "dashed", "dotted", "longdash", "dashdot", "longdashdot"] },
      "strokeOpacity": { "kind": "number", "min": 0, "max": 1 },
      "lineCap": { "kind": "enum", "values": ["butt", "round", "square"] },
      "lineJoin": { "kind": "enum", "values": ["miter", "round", "bevel"] },
      "miterLimit": { "kind": "number", "min": 1, "max": 100 },
      "dashPattern": { "kind": "dash_pattern" }
    },
    "shape": {
      "shape": { "kind": "enum", "required": true, "values": ["rect", "ellipse", "line", "triangle", "diamond", "polygon", "brace", "star", "arc"] },
      "strokePt": { "kind": "number", "required": true, "min": 0.1, "max": 20 },
      "color": { "kind": "color", "required": true },
      "fill": { "kind": "color_or_null", "required": true },
      "start": { "kind": "endpoint" },
      "end": { "kind": "endpoint" },
      "cornerRadius": { "kind": "number", "min": 0, "max": 50 },
      "sides": { "kind": "int", "min": 3, "max": 12 },
      "starRatio": { "kind": "number", "min": 0.05, "max": 0.95 },
      "fillOpacity": { "kind": "number", "min": 0, "max": 1 },
      "dash": { "kind": "enum", "values": ["solid", "dashed", "dotted", "longdash", "dashdot", "longdashdot"] },
      "stroke": { "kind": "bool" },
      "strokeOpacity": { "kind": "number", "min": 0, "max": 1 },
      "lineCap": { "kind": "enum", "values": ["butt", "round", "square"] },
      "lineJoin": { "kind": "enum", "values": ["miter", "round", "bevel"] },
      "miterLimit": { "kind": "number", "min": 1, "max": 100 },
      "dashPattern": { "kind": "dash_pattern" },
      "fillGradient": { "kind": "gradient" },
      "strokeGradient": { "kind": "gradient" },
      "strokeAlign": { "kind": "enum", "values": ["center", "outside"] }
    },
    "path": {
      "subpaths": { "kind": "subpaths", "required": true },
      "strokePt": { "kind": "number", "required": true, "min": 0.1, "max": 20 },
      "color": { "kind": "color", "required": true },
      "fill": { "kind": "color_or_null", "required": true },
      "fillRule": { "kind": "enum", "values": ["evenodd"] },
      "fillOpacity": { "kind": "number", "min": 0, "max": 1 },
      "stroke": { "kind": "bool" },
      "strokeOpacity": { "kind": "number", "min": 0, "max": 1 },
      "dash": { "kind": "enum", "values": ["solid", "dashed", "dotted", "longdash", "dashdot", "longdashdot"] },
      "lineCap": { "kind": "enum", "values": ["butt", "round", "square"] },
      "lineJoin": { "kind": "enum", "values": ["miter", "round", "bevel"] },
      "miterLimit": { "kind": "number", "min": 1, "max": 100 },
      "dashPattern": { "kind": "dash_pattern" },
      "fillGradient": { "kind": "gradient" },
      "strokeGradient": { "kind": "gradient" },
      "strokeAlign": { "kind": "enum", "values": ["inside", "outside"] },
      "headStart": { "kind": "enum", "values": ["none", "triangle", "open", "bar", "dot", "diamond", "stealth"] },
      "headEnd": { "kind": "enum", "values": ["none", "triangle", "open", "bar", "dot", "diamond", "stealth"] },
      "headSizeStart": { "kind": "enum", "values": ["small", "medium", "large"] },
      "headSizeEnd": { "kind": "enum", "values": ["small", "medium", "large"] }
    }
  }
}
